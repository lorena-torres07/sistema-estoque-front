{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/catalogo/browser",
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/catalogo", "destination": "/index.html" },
    { "source": "/produtos", "destination": "/index.html" },
    { "source": "/categorias", "destination": "/index.html" }
  ]
}
